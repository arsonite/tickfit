# Copy to .env (git-ignored) to change a value, the defaults below are used otherwise.
# Port of the vite dev server, homepie's nginx forwards https://homepie.net/tickfit/ to it
# (homepie/src/nginx/conf.d/00-homepie-apps.conf)
TICKFIT_CLIENT_PORT=8104
# Interface of the vite dev server. 127.0.0.1 = only through homepie's nginx (which handles the login), 0.0.0.0 = also
# directly via the IP of the machine, e.g. http://192.168.2.134:8104/, WITHOUT any login
TICKFIT_HOST=127.0.0.1
# Path the app is served under. Standalone it is /, homepie publishes it at https://homepie.net/tickfit/
# (homepie/src/nginx/conf.d/00-homepie-apps.conf), so set /tickfit/ on that server
TICKFIT_BASE_PATH=/
# Port of the HSDB server (tickfit_server.py), only on 127.0.0.1. vite proxies /hsdb to it.
# tickfit_server.py reads .env itself, a variable that is already set in the process environment wins
TICKFIT_PORT=8767

# Root of the HSDB data, the database lives in <path>/hsdb/tickfit/. Empty = HSDB_ROOT_PATH or /var/lib
TICKFIT_DATA_PATH=