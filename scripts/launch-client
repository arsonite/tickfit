# Third-party imports
from teatype.cli import BaseStartCLI

class LaunchClient(BaseStartCLI):
    def pre_execute(self):
        self.process_name = 'tickfit_client'
        self.start_command = 'pnpm start'

if __name__ == '__main__':
    LaunchClient()
